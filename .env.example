# ─────────────────────────────────────────
# Anthropic API Key
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=dein_anthropic_api_key

# ─────────────────────────────────────────
# iCloud Konto: tim.baer@icloud.com
# WICHTIG: Kein normales Passwort!
# → appleid.apple.com → Anmeldung → App-spezifische Passwörter
# ─────────────────────────────────────────
ICLOUD_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─────────────────────────────────────────
# Gmail Konto: timbaer05@gmail.com
# WICHTIG: Kein normales Passwort!
# → Google Konto → Sicherheit → App-Passwörter
# (2-Faktor-Authentifizierung muss aktiv sein)
# ─────────────────────────────────────────
GMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ─────────────────────────────────────────
# Wohin sollen Benachrichtigungen gesendet werden?
# Standard: tim.baer@icloud.com
# ─────────────────────────────────────────
NOTIFY_EMAIL=tim.baer@icloud.com

# ─────────────────────────────────────────
# Wie viele E-Mails pro Konto auf einmal prüfen?
# Standard: 20
# ─────────────────────────────────────────
BATCH_SIZE=20
