# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# E-Mail Einstellungen (IMAP - zum Lesen)
EMAIL_ADDRESS=deine@email.de
EMAIL_PASSWORD=dein_app_passwort

# IMAP Server (Beispiele: imap.gmail.com, imap.gmx.net, imap.web.de)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# SMTP Server (zum Senden von Benachrichtigungen)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Wohin sollen Benachrichtigungen gesendet werden (z.B. deine Handynummer als E-Mail)
NOTIFY_EMAIL=benachrichtigung@email.de

# Wie viele E-Mails auf einmal prüfen (Standard: 20)
BATCH_SIZE=20
